model Author {
   id       String   @id @default(uuid())
  name      String    @unique
  email     String?
   products  Product[] 
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

   userId    String
  user      User      @relation(fields: [userId], references: [id])

 @@map("authors")
}